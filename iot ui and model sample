        "import pandas as pd\n",
        "import numpy as np\n",
        "\n",
        "# 1. Load Data\n",
        "col_names = ['unit', 'cycles', 'os1', 'os2', 'os3'] + [f's{i}' for i in range(1, 22)]\n",
        "df = pd.read_csv('train_FD001.txt', sep='\\s+', header=None, names=col_names)\n",
        "\n",
        "# 2. Add Physics-Informed Features (Thermodynamics)\n",
        "# Pressure Ratio (s12 is LPC outlet, s7 is inlet)\n",
        "df['LPC_Pressure_Ratio'] = df['s12'] / df['s7']\n",
        "\n",
        "# Temperature-Speed Relationship (s3 is HPC outlet temp, s9 is fan speed)\n",
        "# Physically, if temp rises while speed is constant, the engine is working too hard (inefficient)\n",
        "df['Thermal_Stress_Index'] = df['s3'] / df['s9']\n",
        "\n",
        "# Corrected Core Speed (Physical Speed / sqrt(Inlet Temp))\n",
        "df['Corrected_Core_Speed'] = df['s15'] / np.sqrt(df['s2'])\n",
        "\n",
        "print(\"Physics features added successfully!\")"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "# Calculate Remaining Useful Life (RUL) for each unit\n",
        "max_cycles = df.groupby('unit')['cycles'].transform('max')\n",
        "df['RUL'] = max_cycles - df['cycles']"
      ],
      "metadata": {
        "id": "Ao4PN1V-xPrX"
      },
      "execution_count": null,
      "outputs": []
    },
    {
