        "TP = final_df[(final_df['Fault_Injected'] == True) & (final_df['Fault_Detected'] == True)].shape[0]\n",
        "\n",
        "# Calculate False Positives (FP): No fault injected BUT Fault detected\n",
        "FP = final_df[(final_df['Fault_Injected'] == False) & (final_df['Fault_Detected'] == True)].shape[0]\n",
        "\n",
        "# Calculate False Negatives (FN): Fault injected BUT No fault detected\n",
        "FN = final_df[(final_df['Fault_Injected'] == True) & (final_df['Fault_Detected'] == False)].shape[0]\n",
        "\n",
        "# Calculate True Negatives (TN): No fault injected AND No fault detected\n",
        "TN = final_df[(final_df['Fault_Injected'] == False) & (final_df['Fault_Detected'] == False)].shape[0]\n",
