      "source": [
        "### IoT Device Simulation Loop\n",
        "\n",
        "This cell will continuously simulate sensor readings and apply the fault detection logic. It will update every `SIMULATION_INTERVAL` seconds. A simulated fault will be injected periodically to demonstrate detection."
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 1000
        },
        "id": "80031a2a",
        "outputId": "f3c2bc6b-9d69-41d7-88d4-e9c3bd80f066"
      },
      "source": [
        "# --- Main IoT Simulation Loop ---\n",
        "def run_iot_simulation(num_iterations=30):\n",
        "    print(f\"Starting IoT Gas Turbine Monitoring Simulation for {num_iterations} iterations...\")\n",
        "    print(f\"Monitoring interval: {SIMULATION_INTERVAL} seconds. Fault injected every {FAULT_INJECTION_INTERVAL} iterations.\")\n",
        "\n",
        "    all_readings = []\n",
        "\n",
        "    for i in range(num_iterations):\n",
        "        fault_active = (i > 0 and i % FAULT_INJECTION_INTERVAL == 0)\n",
        "        sensor_data = simulate_sensor_data(fault_active=fault_active)\n",
        "        fault_status, fault_details = detect_fault(sensor_data)\n",
        "\n",
        "        all_readings.append({\n",
        "            'Timestamp': sensor_data['Timestamp'],\n",
        "            'TIT': sensor_data['TIT'],\n",
        "            'CDP': sensor_data['CDP'],\n",
        "            'EGT': sensor_data['EGT'],\n",
        "            'Vibration': sensor_data['Vibration'],\n",
        "            'Fault_Status': fault_status,\n",
        "            'Fault_Details': fault_details,\n",
        "            'Fault_Injected': fault_active\n",
        "        })\n",
        "\n",
        "        df_display = pd.DataFrame([all_readings[-1]]) # Display only the latest reading\n",
        "\n",
        "        clear_output(wait=True)\n",
        "        print(f\"--- Iteration {i+1}/{num_iterations} ---\")\n",
        "        print(\"Current Sensor Readings:\")\n",
        "        display(df_display.style.set_properties(**{'background-color': 'red'}, subset=pd.IndexSlice[0, ['Fault_Status', 'Fault_Details']]) if 'Fault' in fault_status else df_display.style.set_properties(**{'background-color': 'lightgreen'}, subset=pd.IndexSlice[0, ['Fault_Status', 'Fault_Details']]))\n",
        "\n",
        "        time.sleep(SIMULATION_INTERVAL)\n",
        "\n",
        "    print(\"\\n--- Simulation Ended ---\")\n",
        "    return pd.DataFrame(all_readings)\n",
        "\n",
        "# Run the simulation\n",
        "# You can change num_iterations to run for longer or shorter\n",
        "# To stop early, interrupt the kernel.\n",
        "final_df = run_iot_simulation(num_iterations=30)\n",
        "\n",
        "print(\"\\nFull Simulation Log:\")\n",
        "display(final_df)\n"
      ],
