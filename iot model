      "source": [
        "### Simulating an IoT Model for Gas Turbine Fault Detection\n",
        "\n",
        "This demonstration will simulate sensor data from a gas turbine, apply a basic fault detection logic (which you can replace with your advanced AI model), and continuously monitor the system as if it were an IoT device.\n",
        "\n",
        "We'll simulate the following parameters:\n",
        "- **Turbine Inlet Temperature (TIT)**\n",
        "- **Compressor Discharge Pressure (CDP)**\n",
        "- **Exhaust Gas Temperature (EGT)**\n",
        "- **Vibration Level**\n",
        "\n",
        "We'll also introduce a mechanism to simulate a fault and observe its detection."
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "6013d65f"
      },
      "source": [
        "import numpy as np\n",
        "import pandas as pd\n",
        "import time\n",
        "import random\n",
        "from IPython.display import display, clear_output\n",
        "\n",
        "# --- Configuration Parameters ---\n",
        "\n",
        "# Normal operating ranges for sensor data\n",
        "NORMAL_RANGES = {\n",
        "    'TIT': {'mean': 1200, 'std': 10, 'low_threshold': 1180, 'high_threshold': 1230},\n",
        "    'CDP': {'mean': 250, 'std': 5, 'low_threshold': 240, 'high_threshold': 260},\n",
        "    'EGT': {'mean': 550, 'std': 8, 'low_threshold': 530, 'high_threshold': 570},\n",
        "    'Vibration': {'mean': 1.5, 'std': 0.1, 'low_threshold': 1.0, 'high_threshold': 2.0}\n",
        "}\n",
        "\n",
        "# Fault thresholds (values outside normal range indicate a fault)\n",
        "FAULT_THRESHOLDS = {\n",
        "    'TIT': {'min': 1240, 'max': 1280}, # Higher than normal\n",
        "    'CDP': {'min': 265, 'max': 280}, # Higher than normal\n",
        "    'EGT': {'min': 580, 'max': 620}, # Higher than normal\n",
        "    'Vibration': {'min': 2.5, 'max': 3.5} # Higher than normal\n",
        "}\n",
        "\n",
        "# Simulation interval in seconds\n",
        "SIMULATION_INTERVAL = 1\n",
        "\n",
        "# How often to introduce a simulated fault (e.g., every 20 readings)\n",
        "FAULT_INJECTION_INTERVAL = 20\n"
      ],
      "execution_count": 21,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "aca5dc00"
      },
      "source": [
        "def simulate_sensor_data(fault_active=False):\n",
        "    \"\"\"Generates synthetic sensor readings for a gas turbine.\"\"\"\n",
        "    data = {}\n",
        "    for param, config in NORMAL_RANGES.items():\n",
        "        if fault_active and param in FAULT_THRESHOLDS:\n",
        "            # Simulate a fault: values deviate significantly\n",
        "            fault_min = FAULT_THRESHOLDS[param]['min']\n",
        "            fault_max = FAULT_THRESHOLDS[param]['max']\n",
        "            data[param] = round(random.uniform(fault_min, fault_max), 2)\n",
        "        else:\n",
        "            # Normal operation: values around the mean with some noise\n",
        "            data[param] = round(np.random.normal(config['mean'], config['std']), 2)\n",
        "\n",
        "    data['Timestamp'] = pd.Timestamp.now()\n",
        "    return data\n",
        "\n",
        "def detect_fault(sensor_data):\n",
        "    \"\"\"Integrate your AI-based fault detection model here.\n",
        "    This function now includes placeholders for your model's inference logic.\n",
        "    \"\"\"\n",
        "    fault_status = 'Normal'\n",
        "    fault_details = []\n",
        "\n",
        "    # --- Placeholder for loading your AI model (if not loaded globally) ---\n",
        "    # Example: if you have a TensorFlow/Keras model:\n",
        "    # from tensorflow import keras\n",
        "    # model = keras.models.load_model('your_ai_model.h5')\n",
        "    # Or if you have a scikit-learn model:\n",
        "    # import joblib\n",
        "    # model = joblib.load('your_ai_model.pkl')\n",
        "\n",
        "    # --- Prepare input for your AI model ---\n",
        "    # Your AI model likely expects a specific input format (e.g., a numpy array\n",
        "    # or a pandas DataFrame of sensor values). You'll need to format `sensor_data` accordingly.\n",
        "    # Example: input_data = pd.DataFrame([sensor_data]) # if your model expects a DataFrame\n",
        "    # Example: input_array = np.array([sensor_data['TIT'], sensor_data['CDP'], ...]) # if your model expects a numpy array\n",
        "\n",
        "    # --- Perform inference using your AI model ---\n",
        "    # Replace this with your model's prediction call\n",
        "    # Example: prediction = model.predict(input_data)\n",
        "    # Example: fault_probability = prediction[0][0]\n",
        "\n",
        "    # --- Interpret your AI model's output ---\n",
        "    # Based on your model's output (e.g., a class, a probability, an anomaly score),\n",
        "    # determine the fault status and details.\n",
        "    # For this demonstration, we'll keep the simple thresholding as a fallback/example.\n",
        "\n",
        "    # Fallback/Example: Simple thresholding (replace with your AI model's logic)\n",
        "    for param, thresholds in NORMAL_RANGES.items():\n",
        "        if sensor_data[param] < thresholds['low_threshold'] or \\\n",
        "           sensor_data[param] > thresholds['high_threshold']:\n",
        "            fault_status = 'Potential Fault'\n",
        "            fault_details.append(f\"{param} anomaly: {sensor_data[param]} (Expected: {thresholds['low_threshold']}-{thresholds['high_threshold']})\")\n",
        "\n",
        "    for param, thresholds in FAULT_THRESHOLDS.items():\n",
        "         if sensor_data[param] >= thresholds['min']:\n",
        "             fault_status = 'Major Fault Detected'\n",
        "             fault_details.append(f\"{param} critically high: {sensor_data[param]} (Threshold: {thresholds['min']})\")\n",
        "\n",
        "    # If your AI model makes a decision, you would update fault_status and fault_details here.\n",
        "    # Example: if fault_probability > 0.8: fault_status = 'AI Model Fault'; fault_details.append('AI detected high fault probability')\n",
        "\n",
        "    return fault_status, \"; \".join(fault_details) if fault_details else \"No anomalies detected\"\n"
      ],
      "execution_count": 22,
      "outputs": []
    },
